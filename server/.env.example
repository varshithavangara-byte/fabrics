# =======================
# SERVER ENVIRONMENT VARS
# =======================

PORT=5000
NODE_ENV=development

# MongoDB Connection URI
# Replace with your MongoDB Atlas URI or local URI
MONGODB_URI=mongodb://localhost:27017/pushpa-fabrics

# JWT Secret (for future auth use)
JWT_SECRET=your_jwt_secret_key_here

# =======================
# EMAIL CONFIGURATION
# =======================
# Gmail credentials for Nodemailer
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Store owner email to receive enquiry notifications
OWNER_EMAIL=owner@pushpafabrics.com

# =======================
# CLIENT URL (for CORS)
# =======================
CLIENT_URL=http://localhost:5173
